# Local SQLite backend — no cloud keys needed.
# `npm run dev` and `npm start` work with no env vars at all.

# Keep true to use the local API (default). Set false only to go back to Supabase.
VITE_LOCAL_DB=true

# Optional: where the browser client looks for the API (default /api).
# VITE_LOCAL_API=/api

# Server-only. Override the folder that holds erp.db + uploaded files.
# Use this to point at a mounted persistent disk/volume.
# ERP_DATA_DIR=./data

# Server-only. Port for `npm start` (most hosts set this automatically).
# PORT=4173
