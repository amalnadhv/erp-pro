# Local SQLite backend — no cloud keys needed.
# `npm run dev` and `npm start` work with no env vars at all.

# Keep true to use the local API (default). Set false only to go back to Supabase.
VITE_LOCAL_DB=true

# Optional: where the browser client looks for the API (default /api).
# VITE_LOCAL_API=/api

# Server-only. Override the folder that holds erp.db + uploaded files.
# Use this to point at a mounted persistent disk/volume.
# ERP_DATA_DIR=./data

# Server-only. Port for `npm start` (most hosts set this automatically).
# PORT=4173

# Server-only. SQL Server migration connection. Set these once on the host and
# the migration screen pre-fills them, so any PC/browser can run an import. The
# password stays on the server and is never sent to the browser; a blank
# password field in the UI reuses it.
# MSSQL_HOST=sreeji
# MSSQL_PORT=1475
# MSSQL_DATABASE=COM_BARAB
# MSSQL_USER=sa
# MSSQL_PASSWORD=
# MSSQL_INSTANCE=
# MSSQL_ENCRYPT=false
# MSSQL_TRUST_CERT=true

# Server-only. SQL Server migration ceilings. Rows are read page by page, so
# these only bound how much legacy data one run imports. Raise them to finish
# a larger database; imported rows are skipped, so a re-run continues.
# MSSQL_MAX_ROWS=1000000
# MSSQL_MAX_VOUCHERS=200000
# MSSQL_PAGE_ROWS=20000
